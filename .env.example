# Desenvolvimento e homologação devem permanecer não indexáveis.
SITE_ENV=staging
SITE_INDEXABLE=false

# Identidade básica do site. Não inclua segredos neste arquivo.
SITE_NAME=Next.js Institucional Starter
SITE_DESCRIPTION=Template reutilizável para desenvolvimento de sites institucionais com Next.js, TypeScript e SCSS Modules.
SITE_LOCALE=pt-BR

# Necessária somente para liberar indexação em produção aprovada.
# Use apenas a URL HTTPS oficial do cliente, sem caminhos, parâmetros ou fragmentos.
# SITE_URL=https://www.dominio-oficial-do-cliente.com.br
